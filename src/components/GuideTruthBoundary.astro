---
import reviewOverrides from '../data/public-review-overrides.json';

interface Props {
  reviewed?: string;
  nextReview?: string;
}

const { reviewed, nextReview } = Astro.props;
const path = Astro.url.pathname;
const isGuideDetail = path.startsWith('/guides/') && path !== '/guides/' && path !== '/guides';
const slug = isGuideDetail ? decodeURIComponent(path.slice('/guides/'.length).replace(/\/$/, '')) : '';
const overrideRecords = reviewOverrides.records as Record<string, any>;
const canonicalMeta = isGuideDetail ? overrideRecords[slug] || null : null;
const canonicalRole = canonicalMeta?.canonicalRole || '';
const canonicalSlug = canonicalMeta?.canonicalSlug || '';

const validDate = (value: unknown) => {
  if (typeof value !== 'string' || !/^\d{4}-\d{2}-\d{2}$/.test(value)) return false;
  const [year, month, day] = value.split('-').map(Number);
  const parsed = new Date(Date.UTC(year, month - 1, day));
  return parsed.getUTCFullYear() === year && parsed.getUTCMonth() === month - 1 && parsed.getUTCDate() === day;
};

const reviewedValid = validDate(reviewed);
const nextReviewValid = validDate(nextReview);
const readerStatus = reviewedValid && nextReviewValid
  ? `Проверено ${reviewed} · следующий пересмотр ${nextReview}`
  : 'Архив. Материал не проверялся на текущую дату: цифры, комиссии и правила бирж могли измениться.';
---

{isGuideDetail && (
  <aside
    class="guide-truth-boundary"
    data-guide-truth-boundary
    data-guide-slug={slug}
    data-review-source="/guides-index.json"
    data-canonical-source="src/data/public-review-overrides.json"
    data-canonical-role={canonicalRole || undefined}
    data-canonical-slug={canonicalSlug || undefined}
    aria-label="Статус материала"
  >
    <p class="gtb-reader-status">{readerStatus}</p>
  </aside>
)}

<style>
  .guide-truth-boundary {
    width: min(1200px, calc(100vw - 40px));
    margin: 22px auto 0;
    padding: 11px 14px;
    border: 1px solid rgba(255,178,46,.30);
    border-radius: 10px;
    background: rgba(255,178,46,.045);
    color: var(--ink);
  }
  .guide-truth-boundary .gtb-reader-status {
    margin: 0;
    color: var(--muted);
    font-size: .78rem;
    line-height: 1.5;
  }
  @media (max-width:620px) {
    .guide-truth-boundary {
      width: min(100% - 28px, 1200px);
      margin-top: 14px;
      padding: 10px 12px;
    }
  }
</style>
