---
interface Props {
	title: string;
	description?: string;
}

const { title, description = "Crypto Guides & AI Libraries — Premium agent-readable decentralized knowledge." } = Astro.props;
---

<!doctype html>
<html lang="ru">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<title>{title}</title>

		<!-- Google Fonts -->
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400..700;1,400..700&family=Playfair+Display:ital,wght@0,400..900;1,400..900&family=Plus+Jakarta+Sans:ital,wght@0,200..800;1,200..800&display=swap" rel="stylesheet" />
	  <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet" />
</head>
	<body>
		<header class="site-header">
			<div class="container header-inner">
				<a href="/" class="brand">
					<div class="brand-logo">◢◤</div>
					<strong>CRYPTO LIBRARY</strong>
				</a>
				<nav class="main-nav">
					<a href="/">Guides</a>
					<a href="https://bitevoagentsite.vercel.app/guides" style="color: var(--blue);">AI Portal</a>
					<a href="/api/guides">API Endpoint</a>
					<a href="/llms.txt" class="btn-llm">LLMs.txt</a>
				</nav>
			</div>
		</header>

		<main>
			<slot />
		</main>

		<footer class="site-footer">
			<div class="container footer-inner">
				<div class="footer-brand">
					<div class="footer-mark">
						<span class="logo-text">◢◤</span>
						<strong>CRYPTO GUIDES</strong>
					</div>
					<p>Decentralized research and agent-readable protocols for the sovereign internet era.</p>
				</div>
				<div class="footer-eco" style="display:flex;gap:14px;flex-wrap:wrap;padding:14px 0;border-top:1px solid rgba(255,255,255,.08);font-size:13px">
					<strong style="opacity:.7">Экосистема:</strong>
					<a href="https://sovereign-arena-site.vercel.app/" style="color:var(--blue)">🏁 Sovereign Arena</a>
					<a href="https://bitevoagentsite.vercel.app/" style="color:var(--blue)">🤖 AI Agent Portal</a>
					<a href="https://cryptoguidessite.vercel.app/" style="color:var(--blue)">📚 Crypto Guides</a>
					<a href="http://34.70.171.152:3000/d/arena-hub" style="color:var(--blue)">🧭 Live Arena Hub</a>
					<a href="http://34.70.171.152:3000/d/arena-lab" style="color:var(--blue)">🧬 Strategy Lab</a>
				</div>
				<div class="footer-bottom">
					<div>© 2026 CRYPTO LIBRARY. All rights reserved.</div>
					<div>Powered by Continuity OS & Astro</div>
				</div>
			</div>
		</footer>
	</body>
</html>

<style is:global>
	:root {
		/* BiTEvo Design System — signal-green / ink-dark terminal */
		--ink: #eaf0f6;
		--muted: #9fadbd;
		--paper: #0a0d12;
		--paper-soft: #12171f;
		--graphite: #12171f;
		--smoke: #1d2531;
		--gold: #ffb22e;
		--green: #34e57a;
		--green-glow: rgba(52, 229, 122, 0.35);
		--blue: #34d3ee;
		--red: #ff5468;
		--line: rgba(52, 229, 122, 0.14);
		--radius: 10px;
		--font-display: 'Space Grotesk', system-ui, sans-serif;
		--font-mono: 'JetBrains Mono', ui-monospace, monospace;
	}

	* {
		box-sizing: border-box;
	}

	html {
		background: radial-gradient(ellipse at 50% -10%, rgba(52,229,122,.07), #0a0d12 60%), var(--paper);
		color: var(--ink);
		font-family: 'Space Grotesk', system-ui, sans-serif;
		font-size: 15px;
		line-height: 1.6;
		overflow-x: hidden;
		min-height: 100vh;
	}

	body {
		margin: 0;
		display: flex;
		flex-direction: column;
		min-height: 100vh;
	}

	.container {
		width: min(1200px, calc(100vw - 40px));
		margin-inline: auto;
	}

	a {
		color: inherit;
		text-decoration: none;
	}

	/* Header */
	.site-header {
		position: fixed;
		top: 0;
		left: 0;
		right: 0;
		z-index: 100;
		border-bottom: 1px solid var(--line);
		background: rgba(8, 13, 15, 0.85);
		backdrop-filter: blur(15px);
	}

	.header-inner {
		display: flex;
		justify-content: space-between;
		align-items: center;
		height: 64px;
	}

	.brand {
		display: flex;
		align-items: center;
		gap: 10px;
	}

	.brand-logo {
		font-size: 16px;
		font-weight: 900;
		color: var(--gold);
	}

	.brand strong {
		font-size: 0.95rem;
		letter-spacing: 0.08em;
	}

	.main-nav {
		display: flex;
		align-items: center;
		gap: 20px;
		font-size: 0.75rem;
		font-weight: 800;
		text-transform: uppercase;
		letter-spacing: 0.06em;
		color: var(--muted);
	}

	.main-nav a:hover {
		color: var(--ink);
	}

	.btn-llm {
		background: linear-gradient(135deg, rgba(189,179,146,0.15), rgba(7,10,12,0.1));
		border: 1px solid rgba(189,179,146,0.3);
		color: var(--ink) !important;
		padding: 6px 14px;
		border-radius: 6px;
		transition: all 0.2s ease;
	}

	.btn-llm:hover {
		border-color: var(--gold);
		background: linear-gradient(135deg, rgba(189,179,146,0.25), rgba(7,10,12,0.15));
		transform: translateY(-1px);
	}

	/* Main section spacing */
	main {
		margin-top: 64px;
		flex-grow: 1;
	}

	/* Footer */
	.site-footer {
		border-top: 1px solid var(--line);
		background: var(--paper-soft);
		margin-top: 60px;
		padding-block: 40px 20px;
	}

	.footer-inner {
		display: flex;
		flex-direction: column;
		gap: 30px;
	}

	.footer-brand {
		display: flex;
		flex-direction: column;
		gap: 12px;
	}

	.