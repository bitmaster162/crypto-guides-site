---
import Layout from '../../../layouts/Layout.astro';

// T1.1 is the English index shell; publishing EN bodies belongs to T1.3.
const enModules = Object.values(import.meta.glob('./*.md', { eager: true })) as any[];
const enGuides = enModules
  .map((module) => module?.frontmatter || {})
  .filter((guide) => guide.lang === 'en'
    && typeof guide.reviewed === 'string'
    && Array.isArray(guide.sources)
    && guide.sources.length > 0
    && guide.path === `/en/guides/${guide.slug}`
    && guide.alternate === `/guides/${guide.slug}`)
  .sort((a, b) => String(a.title || '').localeCompare(String(b.title || ''), 'en-GB'));
const formatEnDate = (value: string) => new Intl.DateTimeFormat('en-GB', {
  day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC'
}).format(new Date(`${value}T00:00:00Z`));
---

<Layout
  lang="en"
  title="Reviewed Guides | Crypto Guides"
  description="English guides backed by dated reviews and source references. Historical archive articles remain in Russian."
  canonical="https://cryptoguidessite.vercel.app/en/guides"
  alternates={{ ru: '/guides', en: '/en/guides' }}
  languageSwitchHref="/guides"
>
  <section class="en-guide-index" data-en-guide-count={enGuides.length}>
    <div class="container">
      <div class="eyebrow">REVIEWED RESEARCH</div>
      <h1>Reviewed guides</h1>
      <p class="lede">Only guides with a review date and source references appear in this English section. Historical material is not translated automatically.</p>
      <section id="en-reviewed-guides" hidden={enGuides.length === 0}>
        <h2>Verified guides</h2>
        <div class="cards">
          {enGuides.map((guide) => (
            <a class="guide-card" href={guide.path}>
              <div class="meta"><span>{guide.category || 'Guide'}</span><span>Checked {formatEnDate(guide.reviewed)}</span></div>
              <h3>{guide.title}</h3>
              <p>{guide.description}</p>
              <small>Read the guide →</small>
            </a>
          ))}
        </div>
      </section>
      {enGuides.length === 0 && (
        <p class="empty" role="status">No reviewed English guides have been published yet.</p>
      )}
      <section id="en-archive-boundary" class="boundary" aria-label="Archive policy">
        <strong>Archive</strong>
        <span>Historical guides remain in the Russian archive. A translated version will be listed only after review and publication approval.</span>
      </section>
      <p class="sources-note">Each published guide includes its sources, review date and next review date.</p>
    </div>
  </section>
</Layout>

<style>
  .en-guide-index { padding: 64px 0 44px; }
  .eyebrow { font: 800 .68rem var(--font-mono); letter-spacing: .12em; color: var(--green); margin-bottom: 10px; }
  .en-guide-index h1 { font-size: clamp(2.2rem,6vw,4.4rem); line-height: 1; margin: 0 0 18px; }
  .lede { max-width: 830px; color: var(--muted); margin-bottom: 24px; }
  .cards { display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); gap: 12px; margin-top: 18px; }
  .guide-card { display: flex; flex-direction: column; padding: 18px; min-height: 240px; border: 1px solid var(--line); border-radius: var(--radius); background: var(--paper-soft); }
  .guide-card .meta { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 8px; font: 700 .68rem var(--font-mono); color: var(--muted); }
  .guide-card h3 { margin: 20px 0 12px; font-size: 1rem; line-height: 1.35; }
  .guide-card p, .sources-note { color: var(--muted); }
  .guide-card small { margin-top: auto; padding-top: 20px; color: var(--green); font-weight: 800; }
  .empty, .boundary { padding: 18px; border: 1px solid var(--line); border-radius: var(--radius); background: var(--paper-soft); }
  .boundary { display: flex; gap: 12px; margin: 28px 0 20px; border-color: rgba(255,178,46,.35); }
  .boundary strong { color: var(--gold); }
  .boundary span { color: var(--muted); }
  @media(max-width: 800px) { .cards { grid-template-columns: 1fr; } .en-guide-index { padding-top: 38px; } }
</style>
