---
import Layout from '../../layouts/Layout.astro';
import taxonomyPolicy from '../../data/public-taxonomy-policy.json';
const taxonomyPolicyJson = JSON.stringify(taxonomyPolicy).replace(/</g, '\\u003c');
---

<Layout title="Гайды · Crypto Guides" description="Публичный индекс восстановленного корпуса Crypto Guides с явной границей текущей ревизии.">
  <section class="guide-index">
    <div class="container">
      <div class="eyebrow">PUBLIC INDEX · SOURCE-DERIVED</div>
      <h1>Гайды и исследования</h1>
      <p class="lede">Индекс генерируется из того же исходного списка, который строит текущие страницы. Корпус восстановлен из июльской версии и сейчас проходит ревизию: наличие страницы не означает, что каждый исторический факт или параметр актуален сегодня.</p>
      <div class="boundary" data-review-status="RESTORED_CORPUS_UNDER_REVIEW">
        <strong>RESTORED_CORPUS_UNDER_REVIEW</strong>
        <span>Карточки соединяют source-derived review/currentness/YMYL из <code>guides-index.json</code> с canonical metadata из reviewed <code>/api/public-guides.json</code>. Метка CANONICAL выбирает предпочтительную ревизию только внутри двух evidence-reviewed duplicate pairs; она не означает, что все утверждения стали current-verified. SUPERSEDED сохраняется как исторический маршрут для provenance.</span>
      </div>
      <div class="controls">
        <label class="search-control"><span>Поиск</span><input id="guide-search" type="search" placeholder="Название, раздел, статус…" autocomplete="off" /></label>
        <label><span>Раздел</span><select id="category-filter"><option value="">Все разделы</option></select></label>
        <label><span>Review status</span><select id="review-filter"><option value="">Все статусы</option></select></label>
        <label><span>YMYL</span><select id="ymyl-filter"><option value="">Все</option><option value="true">Требует YMYL review</option><option value="false">Не помечено YMYL</option></select></label>
        <div id="guide-count" aria-live="polite">Загрузка индекса…</div>
      </div>
      <div id="guide-list" class="cards" data-index-source="/guides-index.json" data-canonical-source="/api/public-guides.json" data-taxonomy-source="src/data/public-taxonomy-policy.json"></div>
      <noscript><p>Для интерактивного фильтра нужен JavaScript. Полный маршрутный индекс также доступен в <a href="/guides-index.json">guides-index.json</a>, reviewed metadata — в <a href="/api/public-guides.json">public-guides.json</a>, а все маршруты — в <a href="/sitemap.xml">sitemap.xml</a>.</p></noscript>
    </div>
  </section>

  <script id="public-taxonomy-policy" type="application/json" set:html={taxonomyPolicyJson}></script>
  <script>
    const list = document.getElementById('guide-list');
    const count = document.getElementById('guide-count');
    const search = document.getElementById('guide-search');
    const categoryFilter = document.getElementById('category-filter');
    const reviewFilter = document.getElementById('review-filter');
    const ymylFilter = document.getElementById('ymyl-filter');
    const taxonomyNode = document.getElementById('public-taxonomy-policy');
    const taxonomyPolicy = taxonomyNode?.textContent ? JSON.parse(taxonomyNode.textContent) : null;
    let records = [];

    const esc = (value = '') => String(value).replace(/[&<>"']/g, (ch) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[ch]));
    const publicCategory = (record) => {
      const status = String(record.reviewStatus || '');
      const direct = taxonomyPolicy?.statusMap?.[status];
      if (direct) return direct;
      for (const rule of taxonomyPolicy?.containsMap || []) {
        if (rule?.token && status.includes(rule.token)) return rule.publicCategory;
      }
      return taxonomyPolicy?.fallback || 'Unclassified / Review';
    };
    const canonicalBadge = (record) => {
      if (record.canonicalRole === 'CANONICAL') return '<span class="badge canonical">CANONICAL</span>';
      if (record.canonicalRole === 'SUPERSEDED_HISTORICAL_REVISION') return '<span class="badge superseded">SUPERSEDED · HISTORICAL</span>';
      return '';
    };
    const populateFilters = () => {
      if (categoryFilter instanceof HTMLSelectElement) {
        const categories = [...new Set(records.map(publicCategory))].sort();
        categoryFilter.innerHTML = '<option value="">Все разделы</option>' + categories.map((category) => `<option value="${esc(category)}">${esc(category)}</option>`).join('');
      }
      if (reviewFilter instanceof HTMLSelectElement) {
        const statuses = [...new Set(records.map((record) => record.reviewStatus).filter(Boolean))].sort();
        reviewFilter.innerHTML = '<option value="">Все статусы</option>' + statuses.map((status) => `<option value="${esc(status)}">${esc(status)}</option>`).join('');
      }
    };
    const render = () => {
      const q = (search instanceof HTMLInputElement ? search.value : '').trim().toLowerCase();
      const selectedCategory = categoryFilter instanceof HTMLSelectElement ? categoryFilter.value : '';
      const selectedStatus = reviewFilter instanceof HTMLSelectElement ? reviewFilter.value : '';
      const selectedYmyl = ymylFilter instanceof HTMLSelectElement ? ymylFilter.value : '';
      const filtered = records.filter((record) => {
        const category = publicCategory(record);
        const haystack = [record.title, record.slug, category, record.reviewStatus, record.currentness, record.canonicalRole, record.canonicalSlug, ...(record.tags || [])].join(' ').toLowerCase();
        const matchesSearch = !q || haystack.includes(q);
        const matchesCategory = !selectedCategory || category === selectedCategory;
        const matchesStatus = !selectedStatus || record.reviewStatus === selectedStatus;
        const matchesYmyl = !selectedYmyl || String(record.ymyl === true) === selectedYmyl;
        return matchesSearch && matchesCategory && matchesStatus && matchesYmyl;
      });
      if (count) count.textContent = `${filtered.length} из ${records.length}`;
      if (!list) return;
      list.innerHTML = filtered.map((record) => {
        const category = publicCategory(record);
        const canonicalNote = record.canonicalRole === 'SUPERSEDED_HISTORICAL_REVISION' && record.canonicalSlug
          ? `<p class="canonical-note">Предпочтительная ревизия: <code>${esc(record.canonicalSlug)}</code></p>`
          : '';
        return `
        <a class="guide-card" href="/guides/${encodeURIComponent(record.slug)}" data-public-category="${esc(category)}" data-canonical-role="${esc(record.canonicalRole || '')}">
          <div class="meta"><span>${esc(category)}</span><span>${esc(record.date || 'historical')}</span></div>
          <div class="badges">
            <span class="badge review">${esc(record.reviewStatus || 'UNREVIEWED')}</span>
            <span class="badge currentness">${esc(record.currentness || 'UNKNOWN')}</span>
            ${record.ymyl === true ? '<span class="badge ymyl">YMYL REVIEW</span>' : ''}
            ${canonicalBadge(record)}
          </div>
          <h2>${esc(record.title)}</h2>
          <p>${esc((record.tags || []).slice(0, 5).join(' · '))}</p>
          ${canonicalNote}
          <small>Открыть материал →</small>
        </a>`;
      }).join('');
    };

    Promise.all([
      fetch('/guides-index.json', { cache: 'no-store' }).then((response) => {
        if (!response.ok) throw new Error(`index ${response.status}`);
        return response.json();
      }),
      fetch('/api/public-guides.json', { cache: 'no-store' }).then((response) => {
        if (!response.ok) throw new Error(`public api ${response.status}`);
        return response.json();
      })
    ])
      .then(([indexPayload, apiPayload]) => {
        const indexRecords = Array.isArray(indexPayload.records) ? indexPayload.records : [];
        const apiRecords = Array.isArray(apiPayload.records) ? apiPayload.records : [];
        if (indexRecords.length !== apiRecords.length || indexRecords.length === 0) {
          throw new Error(`authority count mismatch index=${indexRecords.length} api=${apiRecords.length}`);
        }
        const apiBySlug = new Map(apiRecords.map((record) => [record.slug, record]));
        records = indexRecords.map((record) => {
          const canonical = apiBySlug.get(record.slug);
          if (!canonical) throw new Error(`canonical metadata missing for ${record.slug}`);
          return {
            ...record,
            canonicalGroup: canonical.canonicalGroup || null,
            canonicalDecision: canonical.canonicalDecision || null,
            canonicalSlug: canonical.canonicalSlug || null,
            canonicalRole: canonical.canonicalRole || null,
            claimReview: canonical.claimReview || null,
            lineageReview: canonical.lineageReview || null
          };
        });
        populateFilters();
        render();
      })
      .catch((error) => {
        records = [];
        if (count) count.textContent = 'Authority index временно недоступен';
        if (list) list.innerHTML = `<div class="error">Не удалось согласовать guides-index.json и /api/public-guides.json: ${esc(error.message)}</div>`;
      });

    search?.addEventListener('input', render);
    categoryFilter?.addEventListener('change', render);
    reviewFilter?.addEventListener('change', render);
    ymylFilter?.addEventListener('change', render);
  </script>
</Layout>

<style>
  .guide-index{padding:64px 0 30px}.eyebrow{font:800 .68rem var(--font-mono);letter-spacing:.12em;color:var(--green);margin-bottom:10px}.guide-index h1{font-size:clamp(2.2rem,6vw,4.4rem);line-height:.98;margin:0 0 18px}.lede{max-width:850px;color:var(--muted);font-size:1rem}.boundary{margin:26px 0;padding:16px 18px;border:1px solid rgba(255,178,46,.35);border-radius:var(--radius);background:rgba(255,178,46,.055);display:flex;gap:12px;flex-wrap:wrap}.boundary strong{color:var(--gold);font:800 .72rem var(--font-mono);letter-spacing:.06em}.boundary span{color:var(--muted);font-size:.84rem}.boundary code,.canonical-note code{font:700 .72rem var(--font-mono);color:var(--ink)}.controls{display:grid;grid-template-columns:minmax(260px,1fr) minmax(170px,.45fr) minmax(190px,.52fr) minmax(170px,.4fr) auto;align-items:end;gap:12px;margin:28px 0 16px}.controls label{display:grid;gap:7px}.controls label span{font:700 .68rem var(--font-mono);color:var(--muted);text-transform:uppercase;letter-spacing:.08em}.controls input,.controls select{width:100%;padding:12px 14px;border:1px solid var(--line);border-radius:8px;background:var(--paper-soft);color:var(--ink);font:inherit;outline:none}.controls input:focus,.controls select:focus{border-color:rgba(52,229,122,.5)}#guide-count{font:700 .72rem var(--font-mono);color:var(--muted);white-space:nowrap;padding-bottom:12px}.cards{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px}.guide-card{display:flex;flex-direction:column;min-height:250px;padding:18px;border:1px solid var(--line);border-radius:var(--radius);background:var(--paper-soft);transition:transform .16s ease,border-color .16s ease}.guide-card:hover{transform:translateY(-2px);border-color:rgba(52,229,122,.4)}.guide-card .meta{display:flex;justify-content:space-between;gap:8px;color:var(--muted);font:700 .64rem var(--font-mono)}.badges{display:flex;gap:6px;flex-wrap:wrap;margin-top:14px}.badge{padding:4px 7px;border:1px solid var(--line);border-radius:999px;font:800 .55rem var(--font-mono);letter-spacing:.02em;color:var(--muted);background:rgba(255,255,255,.02)}.badge.review{color:var(--ink)}.badge.ymyl{border-color:rgba(255,178,46,.45);color:var(--gold);background:rgba(255,178,46,.06)}.badge.canonical{border-color:rgba(52,229,122,.5);color:var(--green);background:rgba(52,229,122,.06)}.badge.superseded{border-color:rgba(255,84,104,.38);color:#f1a0aa;background:rgba(255,84,104,.05)}.guide-card h2{font-size:1rem;line-height:1.35;margin:16px 0 10px}.guide-card p{margin:0;color:var(--muted);font-size:.75rem}.guide-card .canonical-note{margin-top:12px;padding-top:10px;border-top:1px solid rgba(255,255,255,.06);color:#d7a2a8}.guide-card small{margin-top:auto;padding-top:20px;color:var(--green);font-weight:800}.error{padding:18px;border:1px solid rgba(255,84,104,.4);border-radius:8px;color:var(--red)}@media(max-width:1180px){.controls{grid-template-columns:1fr 1fr 1fr}.cards{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:720px){.guide-index{padding-top:38px}.controls{grid-template-columns:1fr}.cards{grid-template-columns:1fr}#guide-count{padding-bottom:0}}
</style>
