---
import Layout from '../layouts/Layout.astro';
import taxonomyPolicy from '../data/public-taxonomy-policy.json';
const taxonomyPolicyJson = JSON.stringify(taxonomyPolicy).replace(/</g, '\\u003c');
---

<Layout
  title="Crypto Guides · Reviewed research library"
  description="Review-first Crypto Guides discovery surface backed by the same reviewed metadata authority as the public guide index."
>
  <section class="hero-section" data-root-discovery-authority="REVIEWED_CANONICAL_MERGED">
    <div class="container hero-inner">
      <div class="kicker">REVIEW-FIRST KNOWLEDGE LIBRARY</div>
      <h1 class="display">Crypto Guides</h1>
      <p class="copy">
        Исследовательская библиотека по crypto, trading, AI и infrastructure. Главная страница не хранит отдельную копию корпуса:
        карточки собираются из того же reviewed index и canonical metadata, что и полный каталог.
      </p>
      <div class="authority-note">
        <strong>ONE DISCOVERY AUTHORITY</strong>
        <span>Публикация маршрута не означает current verification. Review status, currentness, YMYL и canonical role сохраняются на discovery surface.</span>
      </div>
      <div class="hero-actions">
        <a class="primary-action" href="/guides">Открыть полный индекс →</a>
        <a class="secondary-action" href="/api/public-guides.json">Reviewed API</a>
      </div>
    </div>
  </section>

  <section class="featured-section">
    <div class="container">
      <div class="section-heading">
        <div>
          <div class="section-kicker">CANONICAL DISCOVERY</div>
          <h2>Последние материалы</h2>
        </div>
        <div id="home-guide-count" aria-live="polite">Согласование authority…</div>
      </div>
      <div
        id="home-guide-list"
        class="guides-grid"
        data-index-source="/guides-index.json"
        data-canonical-source="/api/public-guides.json"
      ></div>
      <noscript>
        <p class="fallback-copy">Для динамической canonical выдачи нужен JavaScript. Используйте <a href="/guides">полный reviewed index</a>.</p>
      </noscript>
    </div>
  </section>

  <script id="root-public-taxonomy-policy" type="application/json" set:html={taxonomyPolicyJson}></script>
  <script>
    const list = document.getElementById('home-guide-list');
    const count = document.getElementById('home-guide-count');
    const taxonomyNode = document.getElementById('root-public-taxonomy-policy');
    const taxonomyPolicy = taxonomyNode?.textContent ? JSON.parse(taxonomyNode.textContent) : null;

    const esc = (value = '') => String(value).replace(/[&<>"']/g, (ch) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[ch]));
    const publicCategory = (record) => {
      const status = String(record.reviewStatus || '');
      const direct = taxonomyPolicy?.statusMap?.[status];
      if (direct) return direct;
      for (const rule of taxonomyPolicy?.containsMap || []) {
        if (rule?.token && status.includes(rule.token)) return rule.publicCategory;
      }
      return taxonomyPolicy?.fallback || 'Unclassified / Review';
    };
    const canonicalBadge = (record) => {
      if (record.canonicalRole === 'CANONICAL') return '<span class="badge canonical">CANONICAL</span>';
      return '';
    };
    const failClosed = (message) => {
      if (count) count.textContent = 'Authority unavailable';
      if (list) list.innerHTML = `<div class="authority-error"><strong>DISCOVERY FAIL-CLOSED</strong><span>${esc(message)}</span><a href="/guides">Открыть reviewed index →</a></div>`;
    };

    Promise.all([
      fetch('/guides-index.json', { cache: 'no-store' }).then((response) => {
        if (!response.ok) throw new Error(`index ${response.status}`);
        return response.json();
      }),
      fetch('/api/public-guides.json', { cache: 'no-store' }).then((response) => {
        if (!response.ok) throw new Error(`public api ${response.status}`);
        return response.json();
      })
    ])
      .then(([indexPayload, apiPayload]) => {
        const indexRecords = Array.isArray(indexPayload.records) ? indexPayload.records : [];
        const apiRecords = Array.isArray(apiPayload.records) ? apiPayload.records : [];
        if (indexRecords.length !== apiRecords.length || indexRecords.length === 0) {
          throw new Error(`authority count mismatch index=${indexRecords.length} api=${apiRecords.length}`);
        }
        if (apiPayload.canonicalization !== 'REVISION_PAIRS_CANONICAL_SELECTED_SUPERSEDED_PRESERVED') {
          throw new Error(`canonical authority mode mismatch: ${apiPayload.canonicalization || 'missing'}`);
        }

        const apiBySlug = new Map(apiRecords.map((record) => [record.slug, record]));
        const merged = indexRecords.map((record) => {
          const canonical = apiBySlug.get(record.slug);
          if (!canonical) throw new Error(`canonical metadata missing for ${record.slug}`);
          if (canonical.title !== record.title) throw new Error(`title authority mismatch for ${record.slug}`);
          return {
            ...record,
            canonicalGroup: canonical.canonicalGroup || null,
            canonicalDecision: canonical.canonicalDecision || null,
            canonicalSlug: canonical.canonicalSlug || null,
            canonicalRole: canonical.canonicalRole || null,
            claimReview: canonical.claimReview || null,
            lineageReview: canonical.lineageReview || null
          };
        });

        const mergedBySlug = new Map(merged.map((record) => [record.slug, record]));
        const canonicalRecords = merged.filter((record) => record.canonicalRole === 'CANONICAL');
        const supersededRecords = merged.filter((record) => record.canonicalRole === 'SUPERSEDED_HISTORICAL_REVISION');
        if (canonicalRecords.length !== 2 || supersededRecords.length !== 2) {
          throw new Error(`canonical role count mismatch winners=${canonicalRecords.length} superseded=${supersededRecords.length}`);
        }
        for (const record of canonicalRecords) {
          if (record.canonicalDecision !== 'EVIDENCE_REVIEWED_CANONICAL_SELECTED' || record.canonicalSlug !== record.slug) {
            throw new Error(`canonical winner authority mismatch for ${record.slug}`);
          }
        }
        for (const record of supersededRecords) {
          const preferred = record.canonicalSlug ? mergedBySlug.get(record.canonicalSlug) : null;
          if (record.canonicalDecision !== 'EVIDENCE_REVIEWED_CANONICAL_SELECTED' || !preferred || preferred.canonicalRole !== 'CANONICAL' || preferred.canonicalGroup !== record.canonicalGroup) {
            throw new Error(`superseded authority target mismatch for ${record.slug}`);
          }
        }

        const featured = merged
          .filter((record) => record.canonicalRole !== 'SUPERSEDED_HISTORICAL_REVISION')
          .sort((a, b) => String(b.date || '').localeCompare(String(a.date || '')) || String(a.slug).localeCompare(String(b.slug)))
          .slice(0, 12);

        if (count) count.textContent = `${featured.length} из ${merged.length} · superseded не промотируются`;
        if (!list) return;
        list.innerHTML = featured.map((record) => {
          const category = publicCategory(record);
          return `
            <article class="guide-card" data-canonical-role="${esc(record.canonicalRole || '')}">
              <div class="card-meta"><span>${esc(category)}</span><span>${esc(record.date || 'historical')}</span></div>
              <div class="badges">
                <span class="badge review">${esc(record.reviewStatus || 'UNREVIEWED')}</span>
                <span class="badge currentness">${esc(record.currentness || 'UNKNOWN')}</span>
                ${record.ymyl === true ? '<span class="badge ymyl">YMYL REVIEW</span>' : ''}
                ${canonicalBadge(record)}
              </div>
              <a href="/guides/${encodeURIComponent(record.slug)}" class="title-link"><h3>${esc(record.title)}</h3></a>
              <p>${esc((record.tags || []).slice(0, 5).join(' · '))}</p>
              <a href="/guides/${encodeURIComponent(record.slug)}" class="read-more">Открыть материал →</a>
            </article>`;
        }).join('');
      })
      .catch((error) => failClosed(error instanceof Error ? error.message : String(error)));
  </script>
</Layout>

<style>
  .hero-section{padding:68px 0 36px;text-align:center}.hero-inner{max-width:900px}.kicker,.section-kicker{font:900 .68rem var(--font-mono);letter-spacing:.12em;color:var(--green);text-transform:uppercase}.display{font-size:clamp(2.8rem,7vw,5.8rem);line-height:.94;margin:12px 0 18px}.copy{max-width:760px;margin:0 auto;color:var(--muted);font-size:1rem}.authority-note{display:flex;gap:10px;flex-wrap:wrap;justify-content:center;margin:24px auto 0;padding:14px 16px;max-width:760px;border:1px solid rgba(255,178,46,.35);border-radius:var(--radius);background:rgba(255,178,46,.05)}.authority-note strong{color:var(--gold);font:800 .65rem var(--font-mono)}.authority-note span{color:var(--muted);font-size:.8rem}.hero-actions{display:flex;gap:10px;justify-content:center;flex-wrap:wrap;margin-top:22px}.primary-action,.secondary-action{padding:10px 14px;border-radius:8px;font-weight:800}.primary-action{background:var(--green);color:#07100a}.secondary-action{border:1px solid var(--line);background:var(--paper-soft)}.featured-section{padding:28px 0 64px}.section-heading{display:flex;align-items:end;justify-content:space-between;gap:20px;margin-bottom:16px}.section-heading h2{font-size:clamp(1.7rem,4vw,2.7rem);margin:6px 0 0}.section-heading #home-guide-count{font:700 .68rem var(--font-mono);color:var(--muted)}.guides-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px}.guide-card{display:flex;flex-direction:column;min-height:260px;padding:18px;border:1px solid var(--line);border-radius:var(--radius);background:var(--paper-soft)}.card-meta{display:flex;justify-content:space-between;gap:8px;color:var(--muted);font:700 .62rem var(--font-mono)}.badges{display:flex;gap:6px;flex-wrap:wrap;margin-top:14px}.badge{padding:4px 7px;border:1px solid var(--line);border-radius:999px;font:800 .53rem var(--font-mono);color:var(--muted)}.badge.review{color:var(--ink)}.badge.ymyl{border-color:rgba(255,178,46,.45);color:var(--gold)}.badge.canonical{border-color:rgba(52,229,122,.5);color:var(--green)}.title-link h3{font-size:1.05rem;line-height:1.35;margin:16px 0 10px}.guide-card p{margin:0;color:var(--muted);font-size:.76rem}.read-more{margin-top:auto;padding-top:20px;color:var(--green);font-weight:800}.authority-error{grid-column:1/-1;display:grid;gap:10px;padding:20px;border:1px solid rgba(255,84,104,.4);border-radius:var(--radius);background:rgba(255,84,104,.05)}.authority-error strong{color:var(--red);font:800 .7rem var(--font-mono)}.authority-error span,.fallback-copy{color:var(--muted)}.authority-error a,.fallback-copy a{color:var(--green);font-weight:800}@media(max-width:960px){.guides-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:640px){.hero-section{padding-top:42px}.guides-grid{grid-template-columns:1fr}.section-heading{align-items:start;flex-direction:column}.section-heading #home-guide-count{white-space:normal}}
</style>
