---

<Layout title="Crypto & Trading Guides Portal">
	<!-- Hero Section -->
	<section class="hero-section">
		<div class="container hero-inner">
			<div class="kicker">Knowledge Library</div>
			<h1 class="display">Crypto & Trading Journal</h1>
			<p class="copy">
				Децентрализованные руководства и плейбуки по криптографии, DeFi, MEV и торговым стратегиям.
			</p>
		</div>
	</section>

	<!-- Guides List -->
	<section class="guides-section">
		<div class="container">
			<div class="guides-grid">
				{guides.map(guide => (
					<article class="guide-card">
						<div class="card-meta">
							<span class="category">{guide.category}</span>
							<span class="dot">·</span>
							<span class="date">{guide.date}</span>
						</div>
						<a href={`/guides/${guide.slug}`} class="title-link">
							<h2 class="display-sm">{guide.title}</h2>
						</a>
						<p class="desc">{guide.desc}</p>
						<div class="card-footer">
							<div class="tags">
								{guide.tags.map(tag => (
									<span class="tag">#{tag}</span>
								))}
							</div>
							<a href={`/guides/${guide.slug}`} class="read-more">Read Guide →</a>
						</div>
					</article>
				))}
			</div>
		</div>
	</section>
</Layout>

<style>
	.hero-section {
		padding-block: 60px 30px;
		text-align: center;
	}
	.kicker {
		color: var(--gold);
		font-size: 0.72rem;
		font-weight: 900;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		margin-bottom: 6px;
	}
	.display {
		font-family: 'Playfair Display', serif;
		font-size: clamp(2.2rem, 5vw, 3.4rem);
		font-weight: 900;
		line-height: 1.15;
		margin: 0;
	}
	.copy {
		font-family: 'Lora', serif;
		color: var(--muted);
		max-width: 600px;
		margin: 12px auto 0;
		font-size: 1rem;
	}

	/* Grid */
	.guides-section {
		padding-block: 20px 60px;
	}
	.guides-grid {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 24px;
		max-width: 1000px;
		margin-inline: auto;
	}
	@media (max-width: 768px) {
		.guides-grid {
			grid-template-columns: 1fr;
		}
	}

	.guide-card {
		background: var(--paper-soft);
		border: 1px solid var(--line);
		border-radius: var(--radius);
		padding: 30px;
		display: flex;
		flex-direction: column;
		transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
	}
	.guide-card:hover {
		transform: translateY(-2px);
		border-color: var(--gold);
		box-shadow: 0 12px 28px rgba(0, 0, 0, 0.4);
	}

	.card-meta {
		display: flex;
		align-items: center;
		gap: 6px;
		font-size: 0.72rem;
		font-weight: 800;
		text-transform: uppercase;
		letter-spacing: 0.05em;
		color: var(--muted);
		margin-bottom: 12px;
	}
	.category {
		color: var(--blue);
	}

	.display-sm {
		font-family: 'Playfair Display', serif;
		font-size: 1.35rem;
		margin: 0 0 12px;
		line-height: 1.25;
		transition: color 0.2s ease;
	}
	.display-sm:hover {
		color: var(--gold);
	}

	.desc {
		font-family: 'Lora', serif;
		color: var(--muted);
		font-size: 0.92rem;
		line-height: 1.6;
		margin: 0 0 20px;
	}

	.card-footer {
		display: flex;
		justify-content: space-between;
		align-items: center;
		margin-top: auto;
		border-top: 1px solid var(--line);
		padding-top: 14px;
	}

	.tags {
		display: flex;
		gap: 8px;
		font-size: 0.75rem;
		font-weight: 700;
		color: var(--muted);
	}

	.read-more {
		font-size: 0.75rem;
		font-weight: 800;
		text-transform: uppercase;
		letter-spacing: 0.05em;
		color: var(--gold);
		transition: transform 0.2s ease;
	}
	.read-more:hover {
		transform: translateX(2px);
	}
</style>
