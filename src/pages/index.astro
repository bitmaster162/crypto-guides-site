const CATEGORY_ORDER = ["Trading","AI","Security","Infrastructure","Governance","Risk","Business","Automation","Service"];
const byCat = {};
guides.forEach(g => { (byCat[g.category] = byCat[g.category] || []).push(g); });
const sections = [
	...CATEGORY_ORDER.filter(c => byCat[c]).map(c => ({ cat: c, items: byCat[c] })),
	...Object.keys(byCat).filter(c => !CATEGORY_ORDER.includes(c)).map(c => ({ cat: c, items: byCat[c] })),
];
---

<Layout title="Crypto & Trading Guides Portal">
	<!-- Hero Section -->
	<section class="hero-section">
		<div class="container hero-inner">
			<div class="kicker">Knowledge Library</div>
			<h1 class="display">Crypto & Trading Journal</h1>
			<p class="copy">
				Децентрализованные руководства и плейбуки по криптографии, DeFi, MEV и торговым стратегиям.
			</p>
		</div>
	</section>

	<!-- Category anchor nav -->
	<section class="cat-nav-section">
		<div class="container">
			<div class="cat-nav">
				{sections.map(s => (
					<a href={`#cat-${s.cat}`} class="cat-pill">{s.cat}<span class="cat-count">{s.items.length}</span></a>
				))}
			</div>
		</div>
	</section>

	<!-- Guides grouped by category -->
	{sections.map(s => (
		<section class="guides-section" id={`cat-${s.cat}`}>
			<div class="container">
				<h2 class="cat-heading">{s.cat}<span class="cat-heading-count">{s.items.length} guides</span></h2>
				<div class="guides-grid">
					{s.items.map(guide => (
						<article class="guide-card">
							<div class="card-meta">
								<span class="category">{guide.category}</span>
								<span class="dot">·</span>
								<span class="date">{guide.date}</span>
							</div>
							<a href={`/guides/${guide.slug}`} class="title-link">
								<h2 class="display-sm">{guide.title}</h2>
							</a>
							<p class="desc">{guide.desc}</p>
							<div class="card-footer">
								<div class="tags">
									{guide.tags.map(tag => (
										<span class="tag">#{tag}</span>
									))}
								</div>
								<a href={`/guides/${guide.slug}`} class="read-more">Read Guide →</a>
							</div>
						</article>
					))}
				</div>
			</div>
		</section>
	))}
</Layout>

<style>
	.hero-section {
		padding-block: 60px 30px;
		text-align: center;
	}
	.kicker {
		color: var(--gold);
		font-size: 0.72rem;
		font-weight: 900;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		margin-bottom: 6px;
	}
	.display {
		font-family: 'Playfair Display', serif;
		font-size: clamp(2.2rem, 5vw, 3.4rem);
		font-weight: 900;
		line-height: 1.15;
		margin: 0;
	}
	.copy {
		font-family: 'Lora', serif;
		color: var(--muted);
		max-width: 600px;
		margin: 12px auto 0;
		font-size: 1rem;
	}

	/* Category structure */
	.cat-nav-section { padding-block: 10px 6px; }
	.cat-nav { display: flex; flex-wrap: wrap; gap: 8px; justify-content: center; }
	.cat-pill {
		display: inline-flex; align-items: center; gap: 6px;
		padding: 6px 14px; border: 1px solid var(--line, #2a2a2a); border-radius: 999px;
		color: var(--muted); text-decoration: none; font-size: 0.82rem; font-weight: 700;
		transition: border-color .15s, color .15s;
	}
	.cat-pill:hover { color: var(--gold); border-color: var(--gold); }
	.cat-count { font-size: 0.7rem; opacity: 0.7; }
	.cat-heading {
		font-family: 'Playfair Display', serif; font-size: 1.6rem; font-weight: 900;
		margin: 8px 0 18px; display: flex; align-items: baseline; gap: 12px;
		border-bottom: 1px solid var(--line, #2a2a2a); padding-bottom: 10px; scroll-margin-top: 20px