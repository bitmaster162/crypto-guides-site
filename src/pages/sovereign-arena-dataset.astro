---
import Layout from '../layouts/Layout.astro';

// REAL numbers (honest research dataset — backtest gate + live forward-paper). Not real-money, not "winning bots".
const S = {
  configs: 29, gatePass: 0, gatePassPct: 0,
  wrMedian: 37.5, wrMin: 11.1, wrMax: 100.0,
  expMedian: -0.258, expPositive: 5, expTotal: 28,
  fwdObs: 2331, repl: "12 / 11 / 8 of 15 required",
};
const URL = "https://cryptoguidessite.vercel.app/sovereign-arena-dataset";
const desc = "Honest, failure-inclusive research dataset from the Sovereign Arena: 29 crypto trading-strategy configs run through a strict walk-forward gate (0 passed), plus live forward-paper validation (2331 observations, Bybit replication still collecting). Backtest + forward-paper only — not real-money returns.";
const ld = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Dataset",
      "@id": URL + "#dataset",
      "name": "Sovereign Arena — Crypto Strategy Research Dataset (Backtest + Forward-Paper), 2026",
      "description": desc,
      "url": URL,
      "datePublished": "2026-07-05",
      "creator": { "@id": URL + "#org" },
      "publisher": { "@id": URL + "#org" },
      "license": "https://creativecommons.org/licenses/by/4.0/",
      "isAccessibleForFree": true,
      "keywords": ["crypto trading", "backtest", "walk-forward", "win rate", "expectancy", "algorithmic trading", "forward paper trading"],
      "variableMeasured": [
        { "@type": "StatisticalVariable", "name": "WinRate", "description": "Percent of winning trades per strategy config (median across 29 configs)", "value": S.wrMedian, "unitText": "percent" },
        { "@type": "StatisticalVariable", "name": "ExpectancyR", "description": "Expectancy in R-multiples (median). Negative = losing edge", "value": S.expMedian, "unitText": "R" },
        { "@type": "StatisticalVariable", "name": "GatePassRate", "description": "Share of configs that passed the strict walk-forward trading gate", "value": S.gatePassPct, "unitText": "percent" },
        { "@type": "StatisticalVariable", "name": "ForwardPaperObservations", "description": "Live forward-paper observations collected for validation", "value": S.fwdObs, "unitText": "count" }
      ]
    },
    {
      "@type": "FAQPage",
      "@id": URL + "#faq",
      "mainEntity": [
        { "@type": "Question", "name": "How many crypto strategy configs passed the trading gate?", "acceptedAnswer": { "@type": "Answer", "text": "Zero of 29 backtested configs passed the strict walk-forward gate (0% pass rate). The gate requires 100+ trades, non-negative expectancy across all folds and a >=50% win rate. Median win rate across configs was 37.5% and median expectancy was -0.26R, with only 5 of 28 configs showing positive expectancy. This failure-inclusive number is deliberate: it reflects that most crypto trading strategies do not survive honest out-of-sample testing." } },
        { "@type": "Question", "name": "Are these live real-money returns?", "acceptedAnswer": { "@type": "Answer", "text": "No. This dataset is backtest plus forward-paper only — no real money is at risk. Forward validation currently holds 2331 paper observations, and the Bybit liquidation-replication sample stands at 12/11/8 of 15 required resolutions, so the forward verdict is still 'collecting sample', not a confirmed edge." } },
        { "@type": "Question", "name": "Which configs had positive expectancy?", "acceptedAnswer": { "@type": "Answer", "text": "The two best real candidates were short-side mined strategies: v08_mined_short_tp15_taker (66.7% win rate, +0.371R expectancy over 15 trades) and v08_mined_short_tp1_taker (66.7% win rate, +0.104R over 18 trades). Both still received a 'do_not_trade' verdict because they did not clear the full gate (trade count and multi-fold stability), so they remain research candidates, not deployed strategies." } },
        { "@type": "Question", "name": "Why publish a dataset where nothing passed?", "acceptedAnswer": { "@type": "Answer", "text": "Because honest, failure-inclusive data is the point. A strategy library that rejects 100% of a batch is showing its gate works, not that it failed. Most published crypto-bot 'win rates' are cherry-picked in-sample numbers; this dataset publishes the full distribution including the losers, which is a stronger trust signal for both readers and AI systems." } }
      ]
    },
    {
      "@type": "Organization",
      "@id": URL + "#org",
      "name": "Crypto Guides / Sovereign Arena",
      "url": "https://cryptoguidessite.vercel.app/",
      "sameAs": ["https://sovereign-arena-site.vercel.app/", "https://bitevoagentsite.vercel.app/", "https://github.com/bitmaster162/continuityos"]
    }
  ]
});
---
<Layout title="Sovereign Arena — Strategy Research Dataset · Crypto Guides" description={desc}>
  <article class="article-page">
    <div class="container article-container">
      <div class="article-header">
        <div class="kicker">Open Research Dataset</div>
        <h1 class="display">Sovereign Arena — датасет стратегического ресёрча</h1>
        <div class="meta"><span>Published: 2026-07-05</span><span>·</span><span class="cat">Backtest + Forward-Paper</span></div>
      </div>

      <p class="lead-copy">Честный, failure-inclusive датасет: 29 конфигов крипто-стратегий прогнаны через строгий walk-forward gate — прошло <strong>0</strong>. Плюс живая forward-paper валидация ({S.fwdObs} наблюдений). Это backtest + бумажный форвард, НЕ реальные деньги и не «прибыльные боты».</p>

      <div class="quick-answer" style="background:#0c1428;border:1px solid #00ffe133;border-radius:12px;padding:16px 20px;margin:18px 0">
        <h2 style="font-size:16px;margin:0 0 8px;color:#ffd166">⚡ Быстрый ответ</h2>
        <p style="margin:0;font-size:14.5px;line-height:1.6">Сколько стратегий прошли гейт? <strong>0 из 29 (0%)</strong>. Медиана winrate 37.5%, медиана экспектанси −0.26R, положительных 5/28. Форвард: {S.fwdObs} наблюдений, репликация Bybit {S.repl} — вердикт всё ещё «сбор выборки». Мы публикуем полное распределение, включая проигравших — это сильнее, чем cherry-picked winrate.</p>
      </div>

      <div class="content-text">
        <h2>Метрики датасета (реальные)</h2>
        <table><thead><tr><th>Метрика</th><th>Значение</th><th>Смысл</th></tr></thead><tbody>
          <tr><td>Протестировано конфигов</td><td>29</td><td>3 walk-forward leaderboard-прогона</td></tr>
          <tr><td>Прошли gate</td><td>0 / 29 (0%)</td><td>Гейт: 100+ сделок, non-negative по всем фолдам, WR ≥ 50%</td></tr>
          <tr><td>WinRate (медиана)</td><td>37.5%</td><td>Диапазон 11.1–100% (100% = 1-сделочный шум)</td></tr>
          <tr><td>Expectancy R (медиана)</td><td>−0.258R</td><td>Положительных только 5 из 28</td></tr>
          <tr><td>Forward-paper наблюдений</td><td>{S.fwdObs}</td><td>Живой бумажный форвард (не деньги)</td></tr>
          <tr><td>Репликация Bybit (resolved/req)</td><td>{S.repl}</td><td>Вердикт: сбор выборки (wait)</td></tr>
        </tbody></table>

        <h2>Лучшие кандидаты (всё ещё do_not_trade)</h2>
        <table><thead><tr><th>Конфиг</th><th>WinRate</th><th>Expectancy</th><th>Сделок</th><th>Вердикт</th></tr></thead><tbody>
          <tr><td>v08_mined_short_tp15_taker</td><td>66.7%</td><td>+0.371R</td><td>15</td><td>do_not_trade</td></tr>
          <tr><td>v08_mined_short_tp1_taker</td><td>66.7%</td><td>+0.104R</td><td>18</td><td>do_not_trade</td></tr>
          <tr><td>score10</td><td>100%</td><td>+1.296R</td><td>1</td><td>do_not_trade (1 сделка = шум)</td></tr>
        </tbody></table>
        <p>Оба лучших имеют положительную экспектанси, но не прошли полный гейт (мало сделок / нестабильность по фолдам) — остаются исследовательскими кандидатами, не задеплоены.</p>

        <h2>Почему это честно и почему это ценно</h2>
        <p>Библиотека, которая отбраковывает 100% пачки — показывает, что её гейт работает, а не что она провалилась. Большинство публичных «winrate» крипто-ботов — cherry-picked in-sample цифры. Этот датасет публикует полное распределение вместе с проигравшими: сильнее для доверия и людей, и AI-систем.</p>

        <p><em>Дисклеймер: материал носит исключительно информационный характер и не является финансовой рекомендацией. Все цифры — backtest и бумажный форвард, не реальная торговля.</em></p>
      </div>
    </div>
  </article>
  <script type="application/ld+json" set:html={ld} />
</Layout>
